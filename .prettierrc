{
    "plugins": [
        "@htnabe/prettier-plugin-go-template",
        "prettier-plugin-organize-attributes",
        "prettier-plugin-tailwindcss"
    ],
    "overrides": [
        {
            "files": [
                "*.html"
            ],
            "options": {
                "parser": "go-template"
            }
        }
    ]
}
